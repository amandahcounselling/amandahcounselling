---
import FeesPage from '../components/FeesPage';
import Layout from '../layouts/Layout.astro';
import PageUnavailable from '../components/PageUnavailable';
import { siteConfig } from '../config';
import { pageContent } from '../lib/content';

const fees = pageContent.fees;
---

<Layout
  title={`${siteConfig.pages.fees.label} - ${siteConfig.practiceName}`}
  description={fees.meta.description}
  canonicalPath="/fees"
  noindex={!siteConfig.pages.fees.enabled}
>
  {
    siteConfig.pages.fees.enabled ? (
      <FeesPage client:load />
    ) : (
      <PageUnavailable title={siteConfig.pages.fees.label} client:load />
    )
  }
</Layout>
