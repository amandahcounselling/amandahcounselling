---
import Layout from '../layouts/Layout.astro';
import HomePage from '../components/HomePage';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';
import { pageContent } from '../lib/content';

const home = pageContent.home;
const specialties = siteConfig.pages.specialties.enabled
  ? (await getCollection('specialties'))
      .sort((a: any, b: any) => a.data.order - b.data.order)
      .slice(0, 3)
      .map((entry: any) => ({
        slug: entry.id,
        title: entry.data.title,
        description: entry.data.description,
      }))
  : [];
---

<Layout
  title={`${siteConfig.practiceName} | ${home.meta.titleSuffix}`}
  description={home.meta.description}
  canonicalPath="/"
>
  <HomePage specialties={specialties} client:load />
</Layout>
