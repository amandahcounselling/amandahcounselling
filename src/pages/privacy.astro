---
import Layout from '../layouts/Layout.astro';
import PrivacyPage from '../components/PrivacyPage';
import PageUnavailable from '../components/PageUnavailable';
import { siteConfig } from '../config';
---

<Layout
  title={`Privacy Policy - ${siteConfig.practiceName}`}
  description="How Amanda Hecimovic Counselling handles personal information when you get in touch or book."
  canonicalPath="/privacy"
  noindex={!siteConfig.pages.privacy.enabled}
>
  {
    siteConfig.pages.privacy.enabled ? (
      <PrivacyPage client:load />
    ) : (
      <PageUnavailable title="Privacy Policy" client:load />
    )
  }
</Layout>
