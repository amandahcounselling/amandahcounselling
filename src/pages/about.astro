---
import Layout from '../layouts/Layout.astro';
import AboutPage from '../components/AboutPage';
import PageUnavailable from '../components/PageUnavailable';
import { siteConfig } from '../config';
import { pageContent } from '../lib/content';

const about = pageContent.about;
---

<Layout
  title={`${siteConfig.pages.about.label} - ${siteConfig.practiceName}`}
  description={about.meta.description}
  canonicalPath="/about"
  noindex={!siteConfig.pages.about.enabled}
>
  {
    siteConfig.pages.about.enabled ? (
      <AboutPage client:load />
    ) : (
      <PageUnavailable title={siteConfig.pages.about.label} client:load />
    )
  }
</Layout>
