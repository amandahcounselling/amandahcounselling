# Copy to `.env` and fill in values as needed.
# Restart `npm run dev` after changing these.

# GitHub admin publishing (production / GitHub token sign-in)
PUBLIC_GITHUB_OWNER=
PUBLIC_GITHUB_REPO=
PUBLIC_GITHUB_BRANCH=main

# Local on-site editing during `npm run dev` (writes to your working tree).
# Off by default. Set to true to show "Start local editing" on /admin.
PUBLIC_ADMIN_LOCAL_EDITING=false
